{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shiur-notes-web",
  "main": "src/entry.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "assets": {
    "directory": "../web-mvp",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://shiurnotes.com",
    "DEPLOY_REV": "v28-api-key-guide"
  },
  "observability": {
    "enabled": true
  }
}
